@startuml usecase_provider
' --------------------------------------------------------------
' Use Case Diagram (b) - HEALTHCARE PROVIDER
' Part 2 of 3 - keeps each diagram small and balanced
' --------------------------------------------------------------
title Clinix - Use Case Diagram (Healthcare Provider)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Inter, Helvetica, sans-serif"
skinparam defaultFontSize 12
skinparam ActorBorderColor #1F4E79
skinparam UsecaseBorderColor #1F4E79
skinparam UsecaseBackgroundColor #EAF2F9
skinparam ArrowColor #555555

left to right direction

actor "Healthcare\nProvider" as Provider
actor Patient as Patient <<external>>

rectangle "Clinix System (Provider capabilities)" {
  usecase "Register / Login"              as UC_Auth
  usecase "Submit Credentials (KYC)"      as UC_Submit
  usecase "Accept Appointment"            as UC_Accept
  usecase "Conduct Video / Audio Call"    as UC_Call
  usecase "Real-time Chat with Patient"   as UC_Chat
  usecase "Write Prescription"            as UC_WriteRx
  usecase "Create Medical Record"         as UC_WriteMR
  usecase "Review AI Medical-Record Draft" as UC_AIDraft
  usecase "Create Referral"               as UC_Refer
  usecase "Manage Schedule \& Availability" as UC_Sched
  usecase "View Earnings"                 as UC_Earn
  usecase "Request Withdrawal"            as UC_Withdraw
}

Provider --> UC_Auth
Provider --> UC_Submit
Provider --> UC_Accept
Provider --> UC_Call
Provider --> UC_Chat
Provider --> UC_WriteRx
Provider --> UC_WriteMR
Provider --> UC_AIDraft
Provider --> UC_Refer
Provider --> UC_Sched
Provider --> UC_Earn
Provider --> UC_Withdraw

' Cross-actor interaction during a consultation
Patient ..> UC_Call : joins
Patient ..> UC_Chat : joins

UC_WriteMR ..> UC_AIDraft : <<extend>>

@enduml
