@startuml dfd_level1
' --------------------------------------------------------------
' DFD Level 1 - decomposition into major processes
' Yourdon/DeMarco notation, no stick-figure actors.
' Lavender styling to match the standard textbook look.
' --------------------------------------------------------------
title Clinix - Data Flow Diagram Level 1

<style>
root {
  BackgroundColor #FFFFFF
  FontName        "Inter, Helvetica, sans-serif"
  FontSize        11
  FontColor       #1F2937
}
rectangle {
  BackgroundColor #E8ECFB
  LineColor       #6B7AB3
  LineThickness   1.4
  FontStyle       bold
  FontColor       #1F2937
  RoundCorner     6
  Padding         8
  Margin          10
}
usecase {
  BackgroundColor #DCE3F7
  LineColor       #6B7AB3
  LineThickness   1.6
  FontStyle       bold
  FontSize        11
  FontColor       #1F2937
  Padding         10
  Margin          14
}
arrow {
  LineColor       #6B7AB3
  LineThickness   1.1
  FontColor       #4A5568
  FontSize        9
}
</style>

skinparam Nodesep 60
skinparam Ranksep 95

' ---- External entities (top row) ----
rectangle "Patient"          as Patient
rectangle "Provider"         as Provider
rectangle "Superadmin"       as Admin
rectangle "Payment Gateway"  as Gateway

' ---- Numbered processes (middle row) ----
usecase "1\nAuthentication"            as P1
usecase "2\nAppointment\nManagement"   as P2
usecase "3\nAI Consultation\n& Triage" as P3
usecase "4\nProvider\nVerification"    as P4
usecase "5\nPayment\nProcessing"       as P5

' ---- Data stores (bottom row) ----
rectangle "D1: User DB"            as D1 #FFFFFF
rectangle "D2: Appointment DB"     as D2 #FFFFFF
rectangle "D3: Medical Records DB" as D3 #FFFFFF
rectangle "D4: Verification DB"    as D4 #FFFFFF
rectangle "D5: Payment DB"         as D5 #FFFFFF

' ---- Entity to process (short labels) ----
Patient  --> P1 : login
Patient  --> P3 : symptoms
Patient  --> P2 : book
Patient  --> P5 : pay

Provider --> P1 : login
Provider --> P4 : credentials
Provider --> P2 : accept

Admin    --> P1 : login
Admin    --> P4 : approve

Gateway  --> P5 : confirm

' ---- Process responses to entity ----
P3 --> Patient : assessment
P2 --> Patient : booking

' ---- Process to data store ----
P1 --> D1
P2 --> D2
P3 --> D3
P4 --> D4
P5 --> D5

' ---- Inter-process flow ----
P5 --> P2 : confirm
@enduml
