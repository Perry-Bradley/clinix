@startuml deployment
' --------------------------------------------------------------
' Deployment Diagram - production topology
'
' Layout strategy (matches the system-architecture cleanup):
'   - Strict top-to-bottom flow:
'       Clients  ->  Cloud (App tier + Data tier)
'   - External SaaS grouped tightly in a right-hand column
'     (Firebase as its own neighbour)
'   - Orthogonal lines (no diagonal spaghetti)
'   - Larger Nodesep / Ranksep for breathing room
'   - Only the non-obvious arrow (CamPay webhook callback)
'     is labelled; connection types are implied by the targets
' --------------------------------------------------------------
title Clinix - Deployment Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Inter, Helvetica, sans-serif"
skinparam defaultFontSize 11
skinparam NodeBorderColor #1F4E79
skinparam NodeBackgroundColor #F5F9FC
skinparam ComponentBorderColor #1F4E79
skinparam ComponentBackgroundColor #EAF2F9
skinparam DatabaseBorderColor #1F4E79
skinparam DatabaseBackgroundColor #FFFFFF
skinparam CloudBorderColor #1F4E79
skinparam CloudBackgroundColor #FBFCFE
skinparam ArrowColor #555555
skinparam linetype ortho
skinparam Nodesep 30
skinparam Ranksep 55

' =========== CLIENT TIER (top) ===========
node "Browser" as Browser {
  component "React Admin\n(Vite build,\nNginx-served)" as ReactAdmin
}

node "Patient / Provider\nMobile Device" as Phone {
  component "Flutter App\n(Android / iOS)" as FlutterApp
}

' =========== CLOUD (middle) ===========
cloud "Railway / Render Cloud" as Cloud {
  node "ASGI Container\n(Daphne)" as ASGI {
    component "Django REST API" as API
    component "Django Channels" as Channels
  }
  node "Worker Container" as Worker {
    component "Celery Worker" as CeleryW
    component "Celery Beat"   as CeleryB
  }
  database "PostgreSQL\n(Managed)" as PG
  database "Redis\n(Managed)"      as Redis
}

' =========== FIREBASE (right) ===========
cloud "Firebase" as Firebase {
  database  "Cloud Storage\n(media + KYC +\nrecordings)" as FS
  component "FCM\n(push)"                                as FCM
  component "Auth\n(Google OAuth)"                       as FBAuth
}

' =========== EXTERNAL SAAS (far right column) ===========
cloud "External SaaS" as Ext {
  component "Agora RTC\n(video / audio)"   as Agora
  component "CamPay API\n(mobile money)"   as CamPay
  component "Twilio\n(SMS OTP)"            as Twilio
  component "Google Maps"                  as Maps
  component "Google AI\n(Gemini + STT)"    as GAI
}

' ---------- Clients -> Cloud ----------
ReactAdmin --> API
FlutterApp --> API
FlutterApp --> Channels

' ---------- Cloud internal ----------
API      --> PG
API      --> Redis
Channels --> Redis
CeleryW  --> Redis
CeleryW  --> PG
CeleryB  --> Redis

' ---------- Cloud -> Firebase ----------
API        --> FS
API        --> FCM
FlutterApp --> FBAuth

' ---------- Cloud -> External SaaS ----------
API --> Agora
API --> CamPay
API --> Twilio
API --> Maps
API --> GAI

' ---------- Direct client connections (after backend issues tokens) ----------
FlutterApp --> Agora
FlutterApp --> Maps

' ---------- Callback (the only labelled arrow) ----------
CamPay --> API : webhook

@enduml
