@startuml ai_provider_recommendation
' --------------------------------------------------------------
' AI Provider Recommendation Architecture (Fig 3.10)
'
' Defensive layout - flat structure, no nested grouping that
' fights with the renderer, no orthogonal-line mode.
' For the time-ordered version of this flow, see the patient
' consultation sequence diagram (Fig 3.5).
' --------------------------------------------------------------
title Clinix - AI Provider Recommendation Architecture

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Inter, Helvetica, sans-serif"
skinparam defaultFontSize 11
skinparam ComponentBorderColor #1F4E79
skinparam ComponentBackgroundColor #EAF2F9
skinparam DatabaseBorderColor #1F4E79
skinparam DatabaseBackgroundColor #FFFFFF
skinparam CloudBorderColor #1F4E79
skinparam CloudBackgroundColor #FFF7E0
skinparam ActorBorderColor #1F4E79
skinparam ArrowColor #555555
skinparam Nodesep 25
skinparam Ranksep 45

actor "Patient" as Patient

component "AI Symptom Checker\nScreen\n(Flutter)"           as UI
component "AI Consultation\nSession Manager\n(Django)"      as Session
component "Google Gemini\nClient"                            as Gemini
component "Structured Assessment\nGenerator"                 as Assess
component "Provider Recommender\nscoring service"            as Reco

database  "Verified Providers\n(approved only)"              as Providers
database  "Patient Vitals\nheart rate / HRV / activity"      as Vitals

cloud "Google Gemini API\n(pre-trained, external)"           as GeminiAPI

' ---- Client to backend ----
Patient --> UI
UI      --> Session

' ---- Backend internal: chat turn ----
Session --> Gemini
Gemini  --> GeminiAPI
Session --> Vitals    : silent context

' ---- End-of-session: structured assessment ----
Session --> Assess
Assess  --> Gemini
Assess  --> Reco      : recommended_specialty

' ---- Recommendation scoring ----
Reco    --> Providers : filter approved

' ---- Result back to the patient ----
Reco    --> UI        : top providers\n+ match_reasons
@enduml
