@startuml system_architecture
' --------------------------------------------------------------
' System Architecture - three-tier component view + external SaaS
' Figure 3.6 in the BTech report
'
' Layout strategy:
'   - Strict top-to-bottom flow: Presentation -> Application -> Data
'   - External SaaS shown on the right as a separate column,
'     reached only from the Application tier
'   - Orthogonal lines to avoid spaghetti
'   - Only non-obvious arrows are labelled
' --------------------------------------------------------------
title Clinix - System Architecture (Three-Tier)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Inter, Helvetica, sans-serif"
skinparam defaultFontSize 11
skinparam ComponentBorderColor #1F4E79
skinparam ComponentBackgroundColor #EAF2F9
skinparam RectangleBorderColor #1F4E79
skinparam RectangleBackgroundColor #F5F9FC
skinparam DatabaseBorderColor #1F4E79
skinparam DatabaseBackgroundColor #FFFFFF
skinparam ArrowColor #555555
skinparam linetype ortho
skinparam Nodesep 25
skinparam Ranksep 50

' =========== PRESENTATION TIER ===========
rectangle "Presentation Tier" as PT #F0F7FB {
  component "Patient\nMobile App\n(Flutter)"    as PatientApp
  component "Provider\nMobile App\n(Flutter)"   as ProviderApp
  component "Admin Dashboard\n(React + Vite)"   as Admin
}

' =========== APPLICATION TIER ===========
rectangle "Application Tier" as AT #F0F7FB {
  component "Django REST API\n(DRF + SimpleJWT)" as API
  component "Django Channels\n(WebSocket)"       as Channels
  component "Celery Workers\n+ Celery Beat"      as Celery
  component "AI Consultation\nService\n(Gemini client)" as AI
  component "Provider\nRecommender"              as Reco
}

' =========== DATA TIER ===========
rectangle "Data Tier" as DT #F0F7FB {
  database "PostgreSQL\n(primary store)"           as PG
  database "Redis\n(cache / channels /\nCelery broker)" as Redis
  database "Firebase Storage\n(media + KYC +\nrecordings)"   as FS
}

' =========== EXTERNAL SERVICES (right column) ===========
rectangle "External Services" as ES #FFF7E0 {
  component "CamPay\n(MTN MoMo /\nOrange Money)" as CamPay
  component "Agora RTC\n(video / audio)"         as Agora
  component "Firebase FCM\n(push)"               as FCM
  component "Twilio\n(SMS OTP)"                  as Twilio
  component "Google Maps"                        as Maps
  component "Google Gemini\n+ Cloud STT"         as GCloud
}

' ---------- Presentation -> Application ----------
' (HTTPS / WSS implied; not labelled to avoid clutter)
PatientApp  --> API
ProviderApp --> API
Admin       --> API
PatientApp  --> Channels
ProviderApp --> Channels

' ---------- Internal Application wiring ----------
API --> AI
API --> Reco
AI  --> Reco       : recommended\nspecialty

' ---------- Application -> Data ----------
API      --> PG
API      --> Redis
API      --> FS
Channels --> Redis
Celery   --> Redis
Celery   --> PG
Celery   --> FS
Reco     --> PG

' ---------- Application -> External ----------
API    --> CamPay
API    --> Agora
API    --> FCM
API    --> Twilio
API    --> Maps
AI     --> GCloud

' ---------- External callback ----------
CamPay --> API     : webhook
@enduml
