@startuml activity_ai_consultation
' --------------------------------------------------------------
' Activity Diagram - AI Consultation (Gemini) flow
' --------------------------------------------------------------
title Clinix - AI Consultation Activity Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Inter, Helvetica, sans-serif"
skinparam ActivityBorderColor #1F4E79
skinparam ActivityBackgroundColor #EAF2F9
skinparam ActivityDiamondBackgroundColor #FFF7E0
skinparam ArrowColor #555555

start
:Patient opens\nAI Symptom Checker;
:Send POST /ai/chat/start/;
:Backend injects silent\nvitals context\n(heart rate, HRV,\nrespiratory rate, activity);
:Gemini returns opening greeting;

repeat
  :Patient sends message\n(text +/- image);
  :POST /ai/chat/<id>/message/;
  :Gemini analyses\nconversation history\n(multimodal);
  if (Red-flag symptoms?) then (Yes)
    :Show emergency advice\n(ER / nearest hospital);
    stop
  else (No)
    :Display next question /\nclarification;
  endif
repeat while (Patient wants to continue?)

:POST /ai/chat/<id>/complete/;
:Gemini returns structured assessment\n(summary, triage_priority,\nrecommended_specialization,\npossible_causes);
:Display assessment to patient;

if (Patient wants doctor consultation?) then (Yes)
  :POST /providers/recommended/\nwith specialty;
  :Show ranked verified providers;
  :Patient books appointment;
else (No)
  :End session;
endif

stop
@enduml
