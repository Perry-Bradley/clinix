@startuml sequence_ai_scribe
' --------------------------------------------------------------
' Sequence Diagram - AI Scribe (call audio -> medical record draft)
' --------------------------------------------------------------
title Clinix - AI Scribe Sequence (Call Audio to Medical Record Draft)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Inter, Helvetica, sans-serif"
skinparam ParticipantBorderColor #1F4E79
skinparam ParticipantBackgroundColor #EAF2F9
skinparam ArrowColor #1F4E79

actor "Provider"         as Provider
participant "Provider App\n(Flutter)" as App
participant "Django API"   as API
queue       "Celery Queue\n(Redis)"   as Celery
participant "Worker"       as Worker
participant "Firebase\nStorage"        as FS
participant "Google Cloud\nSpeech-to-Text" as STT
participant "Google Gemini" as Gemini
database  "PostgreSQL"     as DB
actor "Patient" as Patient

Provider -> App : End consultation
App -> App : Stop local recording

App -> FS : Upload audio.mp3
FS --> App : gs:// URI

App -> API : POST /consultations/<id>/audio/\n{ gs_uri }
API -> Celery : enqueue\ntranscribe_and_draft_record
API --> App   : 202 Accepted

Celery -> Worker : task picked up
Worker -> FS    : Read audio
FS --> Worker   : binary stream
Worker -> STT   : Transcribe audio
STT --> Worker  : transcript text
Worker -> Gemini : Prompt with transcript +\nclinical-note schema
Gemini --> Worker : Structured draft\n(chief complaint, symptoms, dx, tx)
Worker -> DB    : Insert MedicalRecord\n(is_ai_draft=true,\n is_published=false)

Worker -> API   : Notify provider (FCM)
API -> App      : Push "AI draft ready"
Provider -> App : Open draft via deeplink
App -> API      : GET /consultations/records/<id>/
API -> DB       : Fetch record
DB --> API      : record (draft)
API --> App     : record JSON

Provider -> App : Edit + click Publish
App -> API : PATCH /consultations/records/<id>/\n{ is_published: true }
API -> DB  : Update
API -> Patient : Notify "New medical record"
@enduml
